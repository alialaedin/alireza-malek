{
  "name": "alireza-malek (Laravel)",
  "user": "ubuntu",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "server",
      "command": "php artisan serve --host=0.0.0.0 --port=8000"
    },
    {
      "name": "vite",
      "command": "npm run dev"
    }
  ],
  "ports": [
    {
      "name": "app",
      "port": 8000
    },
    {
      "name": "vite",
      "port": 5173
    }
  ]
}
